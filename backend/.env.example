OPENROUTER_API_KEY=sk-or-...
# Must be a model that supports tool/function calling (see openrouter.ai/models)
OPENROUTER_MODEL=openai/gpt-4o-mini

SERVICENOW_INSTANCE=https://devXXXXX.service-now.com
SERVICENOW_USER=svc_ai_agent
SERVICENOW_PASSWORD=change-me

CORS_ORIGINS=http://localhost:5173
REDACT_IPS=true
REDACT_NER=false

# Required on Vercel (the API refuses to run there without it). Share it with your users.
ACCESS_KEY=pick-a-long-random-string
# Optional: allow every deployment URL of your frontend project (regex, matched against the full origin)
# CORS_ORIGIN_REGEX=https://incident-assistant-.*\.vercel\.app

# Documentation search (optional)
# DOCS_PATH=./docs
# DOCS_BASE_URL=https://github.com/YOUR-ORG/YOUR-REPO/blob/main/backend/docs
